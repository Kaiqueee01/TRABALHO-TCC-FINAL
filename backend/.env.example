PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=sistema_inteligente_monitoramento_receitas
DB_CONNECTION_LIMIT=10

ADM_USUARIO=adm
ADM_SENHA=1

SMS_PROVIDER=smsdev

